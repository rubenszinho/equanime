{
  "name": "equanime-agent",
  "private": true,
  "description": "The Análise de Banca agent: Mastra on Workers, for the web app's chat (service binding) and OpenAI-compatible clients (/v1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8789",
    "deploy": "wrangler deploy --minify",
    "test": "vitest run",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@rubrion/beholder-server": "^0.4.1",
    "@rubrion/mastra-cloudflare": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
