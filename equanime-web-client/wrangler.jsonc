{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "equanime-web-client",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Production. The whole hostname sits behind Cloudflare Access; the API gets the user's JWT through the binding.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "equanime.rubrion.ai", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 }
	},
	"vars": {
		// Empty in production (the service binding is used); .dev.vars points it at a local API.
		"EQUANIME_API_URL": "",
		// The assistant checks the Access token itself: it acts for whoever this says.
		"TEAM_DOMAIN": "https://rubrion.cloudflareaccess.com",
		"POLICY_AUD": "52c8e31d91b80da17ecca375adc8050784e2fca741a661b9b60e198641c88a61"
	},
	"services": [
		{
			"binding": "EQUANIME_API",
			"service": "equanime-api"
		},
		{
			"binding": "AGENT",
			"service": "equanime-agent"
		}
	]
}
