{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "equanime-web-client",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	// Production. People sign in with an Equânime account (cookie eq_u); the API resolves the session
	// with WEB_KEY, a secret only this Worker and equanime-api hold.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "equanime.rubrion.ai", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 }
	},
	"vars": {
		// Empty in production (the service binding is used); .dev.vars points it at a local API.
		"EQUANIME_API_URL": "",
		// Turnstile on sign-up and "forgot password" when set (with the TURNSTILE_SECRET secret).
		"TURNSTILE_SITE_KEY": ""
	},
	"services": [
		{
			"binding": "EQUANIME_API",
			"service": "equanime-api"
		},
		{
			"binding": "AGENT",
			"service": "equanime-agent"
		}
	]
}
