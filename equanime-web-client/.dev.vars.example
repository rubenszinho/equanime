# The local API (cd ../equanime-api && npx wrangler dev --port 8787).
EQUANIME_API_URL=http://127.0.0.1:8787
# The key the API trusts for sessions (same value as WEB_KEY in equanime-api/.dev.vars).
WEB_KEY=dev-web-key

# Optional: skip signing in locally and act as this account (unlimited). Leave empty to test sign-in.
DEV_USER=
