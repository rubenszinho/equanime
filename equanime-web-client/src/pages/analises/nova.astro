---
import Layout from "../../layouts/Layout.astro";
import AnalysisForm from "../../components/AnalysisForm";
import { form } from "../../data/copy";
import "../../styles/app.css";
---

<Layout title={`${form.pageTitle} | Equânime`}>
	<section class="wrap page">
		<header class="intro">
			<h1>{form.title}</h1>
			<p class="soft">{form.lead}</p>
		</header>
		<AnalysisForm client:load showExample={import.meta.env.DEV} />
	</section>
</Layout>
