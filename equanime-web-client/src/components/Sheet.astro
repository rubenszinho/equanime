---
// The hero: a board as the document it becomes, each reviewer with a stamped verdict.
import Verdict from "./Verdict";
import { home } from "../data/copy";

const s = home.sheet;
---

<figure class="sheet board" aria-label={s.caption}>
	<header>
		<span>{s.kind}</span>
		<figcaption>{s.caption}</figcaption>
	</header>
	<dl class="who">
		<div><dt>{s.candidate}</dt><dd>{s.people.candidate}</dd></div>
		<div><dt>{s.advisor}</dt><dd>{s.people.advisor}</dd></div>
	</dl>
	{[[s.titulares, s.people.titulares], [s.suplentes, s.people.suplentes]].map(([label, people]) => (
		<section>
			<h3>{label as string}</h3>
			<ul>
				{(people as typeof s.people.titulares).map((person, index) => (
					<li style={`--i: ${index}`}>
						<span class="name">{person.name}{"why" in person && person.why ? <small>{person.why}</small> : null}</span>
						<Verdict status={person.status as "no_conflict_identified"} />
					</li>
				))}
			</ul>
		</section>
	))}
</figure>

<style>
	.board { padding: clamp(1.25rem, 3vw, 2rem); rotate: 0.6deg; }
	header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 0.9rem; border-bottom: 2px solid var(--ink); }
	header span { font: 600 1.25rem/1.2 var(--font-display); }
	figcaption { color: var(--ink-faint); font-size: 0.8rem; }
	.who { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 1rem 0 0.5rem; }
	dt, h3 { color: var(--ink-faint); font: 600 0.78rem/1.3 var(--font-body); }
	dd { margin: 0.15rem 0 0; font-weight: 600; }
	section { margin-top: 1rem; }
	ul { list-style: none; margin: 0.35rem 0 0; padding: 0; }
	li { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding: 0.6rem 0; border-top: 1px solid var(--rule); }
	.name { display: grid; }
	small { color: var(--ink-soft); font-size: 0.8rem; }
	/* The one moment of motion: the stamps land in turn. */
	li :global(.verdict) { animation: stamp 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2) both; animation-delay: calc(0.5s + var(--i) * 0.22s); }
	section + section li :global(.verdict) { animation-delay: calc(1.2s + var(--i) * 0.22s); }
	@keyframes stamp { from { opacity: 0; transform: scale(1.35) rotate(-6deg); } }
	@media (max-width: 420px) { li { flex-direction: column; align-items: flex-start; gap: 0.35rem; } .board { rotate: none; } }
</style>
