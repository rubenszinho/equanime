---
// The first-visit modal: the demo video (video/ in the repo records it). It opens once per
// browser; any [data-intro-open] button opens it again.
import { intro } from "../data/copy";
---

<dialog class="intro" aria-labelledby="intro-title" tabindex="-1" data-intro>
	<div class="intro__head">
		<div>
			<h2 id="intro-title">{intro.title}</h2>
			<p class="soft">{intro.lead}</p>
		</div>
		<button type="button" class="theme intro__close" data-intro-close aria-label={intro.close} title={intro.close}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
		</button>
	</div>
	<video class="intro__video" controls muted playsinline preload="none" poster="/video/equanime-demo.jpg" width="1280" height="720">
		<source src="/video/equanime-demo.mp4" type="video/mp4" />
		<track kind="captions" src="/video/equanime-demo.pt-BR.vtt" srclang="pt-BR" label={intro.captions} default />
	</video>
	<div class="intro__foot">
		<a class="btn btn--primary" href="/analises/nova">{intro.start}</a>
		<button type="button" class="btn btn--quiet" data-intro-close>{intro.later}</button>
	</div>
</dialog>

<style>
	.intro { width: min(960px, 100% - 2rem); max-height: calc(100dvh - 2rem); padding: 0; border: 1px solid var(--hair); border-radius: 14px; background: var(--sheet); color: var(--ink); box-shadow: var(--shadow); overflow: auto; }
	.intro:focus { outline: none; }
	.intro::backdrop { background: rgba(15, 24, 40, 0.55); }
	.intro__head { display: flex; gap: 1rem; justify-content: space-between; align-items: flex-start; padding: 1.25rem 1.25rem 1rem; }
	.intro__head h2 { font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
	.intro__head p { margin-top: 0.35rem; font-size: 0.95rem; }
	.intro__close { flex: none; }
	.intro__video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #0f1828; }
	.intro__foot { display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 1rem 1.25rem 1.25rem; }
	@media (max-width: 480px) {
		.intro__foot > * { flex: 1 1 100%; text-align: center; }
	}
</style>

<script>
	const KEY = "equanime-intro-seen";
	const dialog = document.querySelector<HTMLDialogElement>("[data-intro]");
	const video = dialog?.querySelector("video");
	const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const open = (auto: boolean) => {
		if (!dialog || dialog.open) return;
		dialog.showModal();
		// Focus on the box itself, not a ring on the close button the visitor never reached.
		dialog.focus();
		// Muted autoplay only when the visitor asked for it (a click) or doesn't mind motion.
		if (video && (!auto || !still)) video.play().catch(() => {});
	};
	const close = () => dialog?.close();

	dialog?.addEventListener("close", () => {
		video?.pause();
		try { localStorage.setItem(KEY, "1"); } catch {}
	});
	// A click on the backdrop (outside the box) closes it too.
	dialog?.addEventListener("click", (event) => { if (event.target === dialog) close(); });
	dialog?.querySelectorAll("[data-intro-close]").forEach((button) => button.addEventListener("click", close));
	document.querySelectorAll("[data-intro-open]").forEach((button) => button.addEventListener("click", () => open(false)));

	let seen = true;
	try { seen = localStorage.getItem(KEY) === "1"; } catch {}
	if (!seen && !location.hash) open(true);
</script>
