{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "equanime-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	// This file is production. Local dev overrides the vars in .dev.vars (see .dev.vars.example).
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "api.equanime.rubrion.ai", "custom_domain": true }],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 }
	},
	// The PDF embeds Public Sans so Portuguese accents survive.
	"rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
	"vars": {
		"AUTH_MODE": "access",
		"EXECUTION_MODE": "workflow",
		// http: CNPq's institutional extractor through equanime-collector; upload: users send the XML.
		"COLLECTOR_MODE": "http",
		"COLLECTOR_URL": "https://equanime-collector.rubrion.ai",
		"COLLECTOR_ACCESS_ID": "",
		"WEB_URL": "https://equanime.rubrion.ai",
		"LLM_BASE_URL": "",
		"LLM_MODEL": "",
		"MAX_REVIEWERS": "12",
		"MAX_ANALYSES_PER_HOUR": "30",
		"RETENTION_DAYS": "90",
		"TEAM_DOMAIN": "https://rubrion.cloudflareaccess.com",
		// Comma-separated AUD tags: the web app's Access application (and the API's, if it gets one).
		"POLICY_AUD": "",
		"ACCESS_CLIENT_ID": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "equanime",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVIDENCE",
			"bucket_name": "equanime-evidence"
		}
	],
	"workflows": [
		{
			"binding": "ANALYSIS_WORKFLOW",
			"name": "equanime-analysis",
			"class_name": "AnalysisWorkflow"
		}
	],
	"triggers": {
		"crons": ["0 3 * * *"]
	}
}
