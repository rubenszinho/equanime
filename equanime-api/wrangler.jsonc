{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "equanime-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-14",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	// This file is production. Local dev overrides the vars in .dev.vars (see .dev.vars.example).
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "api.equanime.rubrion.ai", "custom_domain": true }],
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 1 }
	},
	// The PDF embeds Public Sans so Portuguese accents survive.
	"rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
	"vars": {
		// "dev" skips sign-in locally; anything else requires an account session or an integration key.
		"AUTH_MODE": "accounts",
		"EXECUTION_MODE": "workflow",
		// http: equanime-collector on cortex.icmc.usp.br (CNPq's extractor, then CNPq's public search);
		// upload: users send the XML. Either way a CV no source reads goes to upload.
		"COLLECTOR_MODE": "http",
		"COLLECTOR_URL": "https://equanime-collector.rubrion.ai",
		// Access service token "equanime-api" (expires 2027-10-30); its secret is COLLECTOR_ACCESS_SECRET.
		"COLLECTOR_ACCESS_ID": "7e587ca93589b6aa001b731fad18cc75.access",
		"WEB_URL": "https://equanime.rubrion.ai",
		"LLM_BASE_URL": "",
		"LLM_MODEL": "",
		"MAX_REVIEWERS": "12",
		"MAX_ANALYSES_PER_HOUR": "30",
		"RETENTION_DAYS": "90",
		// Who may register and sign in, by email domain (subdomains included); ADMINS always may.
		// Empty opens Equânime to every email (others then spend credits). Until release: USP only.
		"ALLOWED_DOMAINS": "usp.br",
		// Institutions whose people use Equânime for free and without limit: the domain or any subdomain
		// (usp.br covers icmc.usp.br). Everyone else spends credits, one per reviewer.
		"FREE_DOMAINS": "usp.br",
		// "1" logs sign-in codes instead of emailing them (local dev).
		"OTP_LOG": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "equanime",
			"database_id": "cdb6fe43-ed73-474a-9469-7af6366f04b6",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "EVIDENCE",
			"bucket_name": "equanime-evidence"
		}
	],
	"workflows": [
		{
			"binding": "ANALYSIS_WORKFLOW",
			"name": "equanime-analysis",
			"class_name": "AnalysisWorkflow"
		}
	],
	// Sign-in codes from no-reply@rubrion.ai (Cloudflare Email Sending).
	"send_email": [{ "name": "EMAIL" }],
	"triggers": {
		"crons": ["0 3 * * *"]
	}
}
